SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker Compose defaults)
DATABASE_URL=postgres://anil:anil@127.0.0.1:5432/anil_gold

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=anil_gold

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
FRONTEND_URL=http://localhost:5180

# ─── Live gold prices (Faraz.io) ────────────────────────────────────────────
GOLD_LIVE=1
# Background poller → WebSocket stream (requires ASGI: daphne / runserver with daphne)
GOLD_STREAM=1
GOLD_POLL_SECONDS=3
GOLD_PERSIST_SECONDS=120
# Auto-refresh cached snapshot when older than N seconds (GET /gold-price/)
GOLD_STALE_SECONDS=120

# Faraz public market (no auth) — مثقال ۱۷ / سکه / انس
FARAZ_BASE_URL=https://faraz.io
# Optional authenticated Socket.IO (dashboard) — not required for public poll
# FARAZ_USER_ID=
# FARAZ_TOKEN=

# Fallbacks (optional)
# GOLD_BRIDGE_URL=http://127.0.0.1:9100
# GOLD_BRIDGE_API_KEY=
GOLD_SOURCE_LIST_URL=https://sekefarshad.ir/server/api/prices/list.php
GOLD_RIAL_TO_TOMAN=true
GOLD_PROVIDER_URL=

# Multi-worker WebSocket (optional)
# REDIS_URL=redis://127.0.0.1:6379/0
