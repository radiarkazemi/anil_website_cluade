SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker Compose defaults) — leave unset for local SQLite
# DATABASE_URL=postgres://anil:anil@127.0.0.1:5432/anil_gold

# MongoDB (analytics — optional locally)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=anil_gold

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
FRONTEND_URL=http://localhost:5180

# ─── Live gold prices (Faraz.io) ────────────────────────────────────────────
GOLD_LIVE=1
GOLD_STREAM=1
# Production tip: 8–15s poll is enough; 3s is aggressive
GOLD_POLL_SECONDS=3
GOLD_PERSIST_SECONDS=120
GOLD_STALE_SECONDS=120

FARAZ_BASE_URL=https://faraz.io
GOLD_SOURCE_LIST_URL=https://sekefarshad.ir/server/api/prices/list.php
GOLD_RIAL_TO_TOMAN=true
GOLD_PROVIDER_URL=

# Multi-worker WebSocket + shared cache (required on VPS with >1 worker)
# REDIS_URL=redis://127.0.0.1:6379/0
# CACHE_URL=redis://127.0.0.1:6379/1

# ─── Iranian payment gateways ───────────────────────────────────────────────
PAYMENT_SANDBOX=True
PAYMENT_CALLBACK_BASE=http://localhost:8000
# ZARINPAL_MERCHANT_ID=
# IDPAY_API_KEY=

# ─── Media ──────────────────────────────────────────────────────────────────
# Local path (nginx should alias /media/ → this folder in production)
# MEDIA_ROOT=/var/www/anil/backend/media
# Django serves /media/ itself (small VPS only; prefer nginx)
MEDIA_SERVE=0
MAX_UPLOAD_IMAGE_MB=5
# Object storage (Liara / MinIO / Arvan / S3)
# USE_S3=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_REGION_NAME=us-east-1

# ─── Production (copy & fill before go-live) ────────────────────────────────
# DEBUG=False
# SECRET_KEY=<openssl rand -hex 48>
# ALLOWED_HOSTS=goldanil.ir,www.goldanil.ir,185.222.163.116
# CORS_ALLOWED_ORIGINS=https://goldanil.ir,https://www.goldanil.ir,http://185.222.163.116
# CSRF_TRUSTED_ORIGINS=https://goldanil.ir,https://www.goldanil.ir,http://185.222.163.116
# FRONTEND_URL=https://goldanil.ir
# PAYMENT_CALLBACK_BASE=https://goldanil.ir
# PAYMENT_SANDBOX=False
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# THROTTLE_ANON=120/minute
# THROTTLE_USER=400/minute
# THROTTLE_GOLD_LIVE=12/minute
# LOG_LEVEL=INFO
# Then: python manage.py check_prod --strict