SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker Compose defaults)
DATABASE_URL=postgres://anil:anil@127.0.0.1:5432/anil_gold

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_NAME=anil_gold

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
FRONTEND_URL=http://localhost:5180

# ─── Live gold prices (Faraz Abshode / gold_abshd stack) ───────────────────
# Enable live fetch (default on)
GOLD_LIVE=1
# Auto-refresh cached snapshot when older than N seconds (GET /gold-price/)
GOLD_STALE_SECONDS=120
# sekefarshad reports Rial — convert to Toman
GOLD_RIAL_TO_TOMAN=true
# Optional: pin primary instrument id from the catalog
# GOLD_TARGET_ITEM_ID=1012

# Option A — direct upstream (same source goldbridge polls). Works without auth
# for the public list; optional credentials improve reliability.
GOLD_SOURCE_LIST_URL=https://sekefarshad.ir/server/api/prices/list.php
# GOLD_SOURCE_UID=
# GOLD_SOURCE_UTOKEN=

# Option B — local goldbridge service (https://github.com/radiarkazemi/goldbridge)
# GOLD_BRIDGE_URL=http://127.0.0.1:9100
# GOLD_BRIDGE_API_KEY=

# Option C — any custom JSON provider returning price_18k_per_gram / coins
GOLD_PROVIDER_URL=
