# Frontend build-time env (Vite)
# Copy to frontend/.env.production before `npm run build`

# Public API base (must end with /api/v1 or match client.ts default)
VITE_API_URL=https://anil.example.com/api/v1

# Optional explicit WebSocket URL for live gold
# VITE_WS_URL=wss://anil.example.com/ws/gold/
