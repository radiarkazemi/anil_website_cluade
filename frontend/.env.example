# Frontend build-time env (Vite)
# Copy to frontend/.env.production before `npm run build`

# Prefer same-origin relative API (works behind nginx on any host):
VITE_API_URL=/api/v1

# Optional absolute API (only if API is on a different origin):
# VITE_API_URL=https://goldanil.ir/api/v1

# Optional explicit WebSocket URL for live gold (defaults to wss://<host>/ws/gold/)
# VITE_WS_URL=wss://goldanil.ir/ws/gold/
