# Example Nginx for Anil Gold on a single VPS
# Place TLS certs via certbot; replace anil.example.com

upstream anil_api {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name anil.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name anil.example.com;

    # ssl_certificate     /etc/letsencrypt/live/anil.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/anil.example.com/privkey.pem;

    client_max_body_size 8m;

    # Frontend SPA (npm run build → dist/)
    root /var/www/anil/frontend/dist;
    index index.html;

    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Uploaded product / category / hero images
    location /media/ {
        alias /var/www/anil/backend/media/;
        expires 1d;
        add_header Cache-Control "public";
        access_log off;
    }

    # Django static (collectstatic)
    location /static/ {
        alias /var/www/anil/backend/staticfiles/;
        expires 7d;
        access_log off;
    }

    # API + WebSocket gold stream
    location /api/ {
        proxy_pass http://anil_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass http://anil_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    location /admin/ {
        proxy_pass http://anil_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
